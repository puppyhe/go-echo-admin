# Copy to .env and replace every development secret before deployment.
APP_ENV=development
ECHO_ADMIN_SERVER_ADDRESS=:8080
ECHO_ADMIN_SERVER_ALLOWED_ORIGINS=http://localhost:5173
ECHO_ADMIN_DATABASE_DRIVER=mysql
ECHO_ADMIN_DATABASE_HOST=127.0.0.1
ECHO_ADMIN_DATABASE_PORT=3306
ECHO_ADMIN_DATABASE_NAME=echo_admin
ECHO_ADMIN_DATABASE_USER=echo_admin
ECHO_ADMIN_DATABASE_PASSWORD=change-me
ECHO_ADMIN_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
ECHO_ADMIN_AUTH_ACCESS_TTL=15m
ECHO_ADMIN_AUTH_REFRESH_TTL=168h
ECHO_ADMIN_CACHE_ENABLED=true
ECHO_ADMIN_CACHE_ADDRESS=127.0.0.1:6379
ECHO_ADMIN_QUEUE_DRIVER=database
ECHO_ADMIN_QUEUE_ADDRESS=127.0.0.1:6379
ECHO_ADMIN_SCHEDULER_ENABLED=true
ECHO_ADMIN_SCHEDULER_POLL_INTERVAL=10s
ECHO_ADMIN_STORAGE_PROVIDER=local
ECHO_ADMIN_STORAGE_PATH=./data/uploads
ECHO_ADMIN_STORAGE_MAX_BYTES=10485760
ECHO_ADMIN_STORAGE_S3_ENDPOINT=
ECHO_ADMIN_STORAGE_S3_BUCKET=echo-admin
ECHO_ADMIN_STORAGE_S3_REGION=us-east-1
ECHO_ADMIN_STORAGE_S3_ACCESS_KEY=
ECHO_ADMIN_STORAGE_S3_SECRET_KEY=
ECHO_ADMIN_STORAGE_S3_USE_PATH_STYLE=true
ECHO_ADMIN_DEMO_ENABLED=false
